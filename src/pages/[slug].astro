---
// Mall för de övriga sidorna. Texten hämtas från src/content/sidor/<adress>.md
import Bas from '../layouts/Bas.astro';
import { getCollection, render } from 'astro:content';
import { SAJT, jonas, fragor } from '../lib/schema';

export async function getStaticPaths() {
  const sidor = (await getCollection('sidor')).filter((s) => s.id !== 'start');
  return sidor.map((sida) => ({ params: { slug: sida.id }, props: { sida } }));
}
const { sida } = Astro.props;
const { Content } = await render(sida);

// Strukturerad data per sida: frågor och svar på What is this, Om-sida på Who made this.
const adress = `${SAJT}/${sida.id}`;
const schemaPerSida: Record<string, object[]> = {
  'what-is-this': [{
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    url: adress,
    about: { '@id': `${SAJT}/#principles` },
    author: { '@id': jonas['@id'] },
    mainEntity: fragor(sida.body ?? '').map((f) => ({
      '@type': 'Question',
      name: f.fråga,
      acceptedAnswer: { '@type': 'Answer', text: f.svar },
    })),
  }, {
    '@context': 'https://schema.org',
    '@type': 'VideoObject',
    name: 'Digital Design Ethics',
    description: 'A brief run through of One Day Interacts digital design ethics framework: a short summary of each of the 10 principles with examples, hands-on tips for applying them, and challenges met along the way.',
    thumbnailUrl: 'https://i.ytimg.com/vi/4OvWvBm7z5o/maxresdefault.jpg',
    uploadDate: '2022-12-26T23:11:47-08:00',
    duration: 'PT18M18S',
    embedUrl: 'https://www.youtube-nocookie.com/embed/4OvWvBm7z5o',
    contentUrl: 'https://www.youtube.com/watch?v=4OvWvBm7z5o',
    author: { '@id': jonas['@id'] },
  }],
  'who-made-this': [{
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    url: adress,
    mainEntity: { '@id': jonas['@id'] },
  }],
};
---
<Bas titel={sida.data.sidtitel} beskrivning={sida.data.beskrivning} bild={sida.data.delningsbild} schema={schemaPerSida[sida.id]}>
  <article class={`innehall ${sida.id}`}>
    <Content />
  </article>
</Bas>
