---
// Grundmallen som alla sidor använder: <head>, sidhuvud och sidfot.
import '@fontsource/inter-tight/400.css';
import '@fontsource/inter-tight/600.css';
import '../styles/global.css';
import { SAJT, jonas } from '../lib/schema';

// ingenIndex: sidan ska inte visas i sökresultat (används av felsidan 404)
interface Props { titel: string; beskrivning?: string; bild?: string; schema?: object[]; ingenIndex?: boolean }
const { titel, beskrivning = '', bild = '/bilder/dde10-open-graph-FB.png', schema = [], ingenIndex = false } = Astro.props;
const sajt = SAJT;
// Strukturerad data (schema.org) som hjälper Google och AI-tjänster att förstå sajten.
const webbplats = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Digital Design Ethics',
  url: sajt + '/',
  inLanguage: 'en',
  publisher: { '@id': 'https://www.onedayinteract.se/#organisation' },
};
const organisation = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://www.onedayinteract.se/#organisation',
  name: 'One Day Interact',
  url: 'https://www.onedayinteract.se',
  email: 'jonas@onedayinteract.se',
  logo: sajt + '/bilder/odi-avatar-wordmark-black.png',
  founder: { '@id': jonas['@id'] },
};
const person = { '@context': 'https://schema.org', ...jonas };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Sidans adress utan .html och utan snedstreck på slutet, t.ex. /what-is-this
const sökväg = Astro.url.pathname.replace(base, '').replace(/\.html$/, '').replace(/\/$/, '').replace(/^\/index$/, '') || '/';
const meny = [
  { text: 'Home', href: '/' },
  { text: 'What is this?', href: '/what-is-this' },
  { text: 'Who made this?', href: '/who-made-this' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titel}</title>
  {beskrivning && <meta name="description" content={beskrivning} />}
  <meta name="author" content="Jonas Engkvist, One Day Interact" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Digital Design Ethics" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:url" content={new URL(sökväg, Astro.site)} />
  <meta property="og:title" content={titel} />
  {beskrivning && <meta property="og:description" content={beskrivning} />}
  <meta property="og:image" content={new URL(base + bild, Astro.site)} />
  <meta property="og:image:alt" content="Digital Design Ethics: 10 universal principles for ethics in digital design" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href={base + '/bilder/favicon.png'} type="image/png" />
  {ingenIndex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={new URL(sökväg, Astro.site)} />}
  {[webbplats, organisation, person, ...schema].map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
</head>
<body>
  <a class="hoppa" href="#innehall">Skip to content</a>
  <header class="sidhuvud">
    <a class="logga" href={base + '/'}>Digital Design Ethics</a>
    <nav aria-label="Main menu">
      <ul>
        {meny.map((m) => (
          <li><a href={base + m.href} aria-current={sökväg === m.href ? 'page' : undefined}>{m.text}</a></li>
        ))}
        <li><a href="mailto:jonas@onedayinteract.se">Contact</a></li>
      </ul>
    </nav>
  </header>
  <main id="innehall">
    <slot />
  </main>
  <footer class="sidfot">
    <p>© 2020–{new Date().getFullYear()} by <a href="https://onedayinteract.se/">One Day Interact</a></p>
    <p>Use or share any way you like. We appreciate if you tell people where you got it from. / Cheers</p>
  </footer>
</body>
</html>
